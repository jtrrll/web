package pages

import "fmt"
import "github.com/jtrrll/portfolio/internal/components"
import "github.com/jtrrll/portfolio/internal/services/software"
import "strings"

templ SoftwareProject(svc *software.Service, name string) {
	@components.Layout(fmt.Sprintf("%s - Jackson Terrill", name), fmt.Sprintf("Jackson Terrill's %s project", name)) {
		{{
			data := svc.GetRepositorySummary(ctx, name)
		}}
		for repo := range data {
			if repo != nil {
				@components.Header(repo.Name, repo.Description)
				<div class="project-about">
					<h2>ABOUT</h2>
					<p>{ repo.Description }</p>
					if len(repo.Topics) > 0 {
						<div class="project-tags">
							<h3>Tags</h3>
							<div class="project-tags-list">
								for _, topic := range repo.Topics {
									<span class="project-tag">#{ strings.ToLower(topic) }</span>
								}
							</div>
						</div>
					}
					if len(repo.Languages) > 0 {
						<div class="project-languages">
							<h3>Languages</h3>
							<div class="project-language-bar">
								for _, lang := range topLanguages(repo.Languages, len(repo.Languages)) {
									<div class={ "project-language-bar-segment", languageClass(lang) } style={ fmt.Sprintf("width: %.1f%%;", languagePercentage(repo.Languages, lang)) }></div>
								}
							</div>
							<div class="project-language-legend">
								for _, lang := range topLanguages(repo.Languages, len(repo.Languages)) {
									<div class="project-language-item">
										<span class={ "project-language-dot", languageClass(lang) }></span>
										<span class="project-language-name">{ lang }</span>
										<span class="project-language-pct">
											{ fmt.Sprintf("%.1f%%", languagePercentage(repo.Languages, lang)) }
										</span>
									</div>
								}
							</div>
						</div>
					}
					<a
						href={ templ.SafeURL(fmt.Sprintf("https://github.com/jtrrll/%s", repo.Name)) }
						target="_blank"
						rel="noopener noreferrer"
						class="clickable project-github-link"
					>
						<svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
						</svg>
						<span>View on GitHub</span>
					</a>
				</div>
				if repo.ReadmeHTML != "" {
					<div class="project-readme">
						<h2>README</h2>
						<div class="project-readme-content">
							@templ.Raw(repo.ReadmeHTML)
						</div>
					</div>
				}
			} else {
				@components.Header(name, "project not found")
				<p>This project could not be found.</p>
				<a href="/software" class="clickable">Back to Software</a>
			}
		}
	}
}

func languagePercentage(languages map[string]int, name string) float64 {
	total := 0
	for _, bytes := range languages {
		total += bytes
	}
	if total == 0 {
		return 0
	}
	return float64(languages[name]) * 100.0 / float64(total)
}
